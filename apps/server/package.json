{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "seed": "tsx src/scripts/sembrar.ts",
    "prueba-impresora": "tsx --env-file-if-exists=.env src/scripts/prueba-impresora.ts",
    "vista-impresion": "tsx src/scripts/vista-impresion.ts",
    "buscar-impresora": "tsx src/scripts/buscar-impresora.ts",
    "enviar-impresora": "tsx --env-file-if-exists=.env src/scripts/enviar-impresora.ts",
    "clave-respaldo": "tsx src/scripts/clave-respaldo.ts",
    "restaurar": "tsx --env-file-if-exists=.env src/scripts/restaurar.ts",
    "dev": "prisma migrate deploy && tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "start:capacitacion": "tsx --env-file-if-exists=.env src/index.ts --capacitacion",
    "dev:capacitacion": "tsx watch --env-file-if-exists=.env src/index.ts --capacitacion",
    "preparar-capacitacion": "tsx src/scripts/capacitacion.ts preparar",
    "reiniciar-capacitacion": "tsx src/scripts/capacitacion.ts reiniciar",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@apurimeno/contracts": "workspace:^",
    "@apurimeno/domain": "workspace:^",
    "@apurimeno/formato": "workspace:^",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.12.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@apurimeno/eslint-config": "workspace:^",
    "@apurimeno/typescript-config": "workspace:^",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22",
    "eslint": "^9.15.0",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "5.5.4",
    "vitest": "^3.2.4"
  }
}
