# Copie como .env.local (no se sube al repositorio). `pnpm build` y `pnpm dev` lo leen.
# Proyecto de Supabase del espejo y su clave PUBLICABLE (Project Settings → API Keys). Nunca la secreta: la
# compilación falla con ella, porque quedaría dentro del sitio publicado.
NEXT_PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
