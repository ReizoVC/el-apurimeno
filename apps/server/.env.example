# Copie a .env y ajuste. Prisma no carga .env solo: exporte las variables o use un gestor de entorno.
DATABASE_URL="file:./datos/apurimeno.db"
# Obligatorio en producción, al menos 32 caracteres (ej. openssl rand -hex 32).
JWT_SECRET=""
HOST="0.0.0.0"
PORT="3001"
# Orígenes de navegador permitidos (CORS), exactos y separados por comas; nunca "*".
# Vacío: en desarrollo, las apps en localhost (3000, 3002, 3003); en producción, ninguno.
# Ej. para el celular de limpieza en la red del local: CORS_ORIGINS="http://192.168.1.50:3002"
CORS_ORIGINS=""
# Solo para `pnpm seed`: crea el usuario administrador inicial.
SEED_ADMIN_USER="admin"
SEED_ADMIN_PASSWORD=""
