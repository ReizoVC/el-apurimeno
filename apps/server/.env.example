# Copie a .env y ajuste: `pnpm start`, `pnpm dev` y `pnpm migrate` lo leen solos (no se sube al repositorio).
# Las variables ya definidas en el entorno tienen prioridad. Un valor vacío es lo mismo que no definirlo.
DATABASE_URL="file:./datos/apurimeno.db"
# Obligatorio en producción, al menos 32 caracteres (ej. openssl rand -hex 32).
JWT_SECRET=""
HOST="0.0.0.0"
PORT="3001"
# Orígenes de navegador permitidos (CORS), exactos y separados por comas; nunca "*".
# Vacío: en desarrollo, las apps en localhost (3000, 3002, 3003); en producción, ninguno.
# Ej. para el celular de limpieza en la red del local: CORS_ORIGINS="http://192.168.1.50:3002"
CORS_ORIGINS=""
# Solo para `pnpm seed`: crea el usuario administrador inicial.
SEED_ADMIN_USER="admin"
SEED_ADMIN_PASSWORD=""
# Impresora de comprobantes (ESC/POS). Vacío: los comprobantes quedan en cola sin imprimir.
# Ej. Linux con la impresora por USB: IMPRESORA_DISPOSITIVO="/dev/usb/lp0"
IMPRESORA_DISPOSITIVO=""
# PC850 (por defecto) o WPC1252, según la página de prueba: pnpm prueba-impresora prueba.bin
IMPRESORA_PAGINA_CODIGOS="PC850"
# Espejo en la nube (ADR-06): resumen para la propietaria en Supabase. Vacío: sin espejo, el local funciona igual.
# Ver supabase/README.md para crear las tablas y la cuenta de sincronización.
ESPEJO_SUPABASE_URL=""
# La clave PUBLICABLE del proyecto (sb_publishable_...). Nunca la secreta: el servidor la rechaza.
ESPEJO_SUPABASE_ANON_KEY=""
# Cuenta de Supabase Auth con rol "sincronizador" en privado.acceso_espejo.
ESPEJO_SYNC_EMAIL=""
ESPEJO_SYNC_PASSWORD=""
# Minutos entre sincronizaciones automáticas, de 5 a 1440.
ESPEJO_INTERVALO_MINUTOS="30"
